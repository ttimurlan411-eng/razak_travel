rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc(uid) {
      return exists(userDocPath(uid));
    }

    function userRole(uid) {
      return hasUserDoc(uid) ? get(userDocPath(uid)).data.role : null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (userRole(request.auth.uid) == "admin" ||
         userRole(request.auth.uid) == "owner");
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.role == "user";
      allow update: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isBanned == resource.data.isBanned
      );
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();

      match /departures/{departureId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
}
